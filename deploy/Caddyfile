# SITE_ADDRESS is ":80" until a domain points at the VM; a domain name enables
# automatic HTTPS (deploy/bin/write-env.sh, docs/runbooks/vm.md).
{$SITE_ADDRESS::80} {
	# The game server's matches (ADR-0033); WebSocket upgrades pass straight through.
	handle /game/* {
		reverse_proxy game:8080
	}
	# P4-W22-S04 (CACHE-4): voiced explainers from SeaweedFS's media bucket. Reads only:
	# SeaweedFS has no S3 auth here, so nothing else may reach it from outside.
	handle /media/* {
		@read method GET HEAD
		handle @read {
			# The path only: no query string (S3 subresources such as ?acl) reaches it.
			rewrite * /interval-media{path}
			reverse_proxy seaweedfs:8333
		}
		respond 405
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
