# VM mode (ADR-0011), Q-P2-13 (P2-W8-S05): collect finished question batches, then
# submit what needs drafting or validating (QUESTIONS_MODEL=batch:<model>). Started by
# interval-question-batches.timer; the AWS stack runs the same command every 30 minutes
# from EventBridge Scheduler.
[Unit]
Description=Interval question-batches
# Requisite, not Requires: a stack stopped for maintenance skips the run instead of
# being started again by the timer.
Requisite=interval.service
After=interval.service

[Service]
Type=oneshot
WorkingDirectory=/opt/interval
ExecStart=/opt/interval/deploy/bin/stack.sh run question-batches
# A oneshot has no start timeout by default: a hung run would stop the timer for good.
TimeoutStartSec=10min
