# VM mode (ADR-0011), ING-6 (P1-W6-S03): queue this week's link health check of every
# item. Started by interval-links.timer; the AWS stack runs the same command weekly
# from EventBridge Scheduler.
[Unit]
Description=Interval check-links-due
# Requisite, not Requires: a stack stopped for maintenance skips the run instead of
# being started again by the timer.
Requisite=interval.service
After=interval.service

[Service]
Type=oneshot
WorkingDirectory=/opt/interval
ExecStart=/opt/interval/deploy/bin/stack.sh run check-links-due
# A oneshot has no start timeout by default: a hung run would stop the timer for good.
TimeoutStartSec=10min
