# VM mode (ADR-0011), P4-W24-S01b (Q-P4-13): the opt-in pushes whose hour has come. Started
# by interval-push.timer; the AWS stack runs the same command hourly from EventBridge
# Scheduler.
[Unit]
Description=Interval push-due
# Requisite, not Requires: a stack stopped for maintenance skips the pass instead of
# being started again by the timer.
Requisite=interval.service
After=interval.service

[Service]
Type=oneshot
WorkingDirectory=/opt/interval
ExecStart=/opt/interval/deploy/bin/stack.sh run push-due
# A oneshot has no start timeout by default: a hung pass would stop the timer for good.
TimeoutStartSec=30min
