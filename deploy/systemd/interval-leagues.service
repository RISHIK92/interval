# VM mode (ADR-0011), ADR-0045: close past weekly leagues (ranks, tier moves) and form
# this week's cohorts, each once. Started hourly by interval-leagues.timer; the AWS
# stack runs the same command hourly from EventBridge Scheduler.
[Unit]
Description=Interval close-leagues-due
# Requisite, not Requires: a stack stopped for maintenance skips the run instead of
# being started again by the timer.
Requisite=interval.service
After=interval.service

[Service]
Type=oneshot
WorkingDirectory=/opt/interval
ExecStart=/opt/interval/deploy/bin/stack.sh run close-leagues-due
# A oneshot has no start timeout by default: a hung run would stop the timer for good.
TimeoutStartSec=10min
