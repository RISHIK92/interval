{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "priority": {
      "type": "string",
      "enum": ["ranked", "rooms", "casual", "run"]
    },
    "language": {
      "type": "string",
      "enum": ["python", "javascript", "typescript", "java", "cpp", "go"]
    },
    "files": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "content": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "required": ["name", "content"],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "memoryMB": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1024
        }
      },
      "required": ["seconds", "memoryMB"],
      "additionalProperties": false
    },
    "runs": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stdin": {
            "type": "string",
            "maxLength": 1048576
          },
          "expected": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "call": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "value": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": ["call", "value"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "call": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "error": {
                      "type": "string",
                      "pattern": "^[\\x20-\\x7e]{0,200}$"
                    }
                  },
                  "required": ["call", "error"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "checks": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 31
                },
                "compare": {
                  "type": "string",
                  "enum": ["exact", "unordered", "approx"]
                },
                "tolerance": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.1
                }
              },
              "required": ["method", "compare"],
              "additionalProperties": false
            }
          },
          "returnOutput": {
            "type": "boolean"
          }
        },
        "required": ["stdin"],
        "additionalProperties": false
      }
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "priority",
    "language",
    "files",
    "limits",
    "runs",
    "submittedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
