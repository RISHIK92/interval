{
  "name": "@interval/hld",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc",
    "test": "vitest run",
    "simulate": "node --import ../../scripts/ts-resolve.mjs src/simulate-cli.ts",
    "pool": "node --import ../../scripts/ts-resolve.mjs src/pool-cli.ts && prettier --write src/pool.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@interval/config": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
