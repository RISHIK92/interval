{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "calls": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 31
          },
          "args": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": ["method", "args"],
        "additionalProperties": false
      }
    },
    "concurrent": {
      "type": "object",
      "properties": {
        "after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "threads": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 31
                },
                "args": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  }
                }
              },
              "required": ["method", "args"],
              "additionalProperties": false
            }
          }
        }
      },
      "required": ["after", "threads"],
      "additionalProperties": false
    }
  },
  "required": ["calls"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
