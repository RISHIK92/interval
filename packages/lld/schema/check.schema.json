{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31
    },
    "compare": {
      "type": "string",
      "enum": ["exact", "unordered", "approx"]
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.1
    }
  },
  "required": ["method", "compare"],
  "additionalProperties": false
}
