{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["prettier.config.js", ".prettierignore", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit", "@interval/db#db:apply"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "VALKEY_URL",
        "CI",
        "PRIVATE_CONTENT_BUCKET",
        "AWS_REGION",
        "S3_ENDPOINT",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ]
    },
    "//#format:check": {
      "inputs": [
        "$TURBO_ROOT$/*.json",
        "$TURBO_ROOT$/*.js",
        "$TURBO_ROOT$/*.yaml"
      ]
    },
    "//#format:py": {
      "cache": false
    },
    "//#format-check:py": {
      "inputs": [
        "$TURBO_ROOT$/pyproject.toml",
        "$TURBO_ROOT$/uv.lock",
        "$TURBO_ROOT$/workers/jobs/**",
        "$TURBO_ROOT$/packages/db/python/**",
        "$TURBO_ROOT$/scripts/**",
        "!$TURBO_ROOT$/**/.venv/**"
      ]
    },
    "//#lint:py": {
      "inputs": [
        "$TURBO_ROOT$/pyproject.toml",
        "$TURBO_ROOT$/uv.lock",
        "$TURBO_ROOT$/workers/jobs/**",
        "$TURBO_ROOT$/packages/db/python/**",
        "$TURBO_ROOT$/scripts/**",
        "!$TURBO_ROOT$/**/.venv/**"
      ]
    },
    "//#typecheck:py": {
      "inputs": [
        "$TURBO_ROOT$/pyproject.toml",
        "$TURBO_ROOT$/uv.lock",
        "$TURBO_ROOT$/workers/jobs/**",
        "$TURBO_ROOT$/packages/db/python/**",
        "$TURBO_ROOT$/scripts/**",
        "!$TURBO_ROOT$/**/.venv/**"
      ]
    },
    "//#test:py": {
      "dependsOn": ["@interval/db#db:apply"],
      "cache": false,
      "env": ["DATABASE_URL", "VALKEY_URL", "CI", "OCR_URL"]
    },
    "check": {
      "dependsOn": [
        "format:check",
        "lint",
        "typecheck",
        "test",
        "//#format:check",
        "//#format-check:py",
        "//#lint:py",
        "//#typecheck:py",
        "//#test:py",
        "db:check"
      ]
    },
    "db:check": {
      "cache": false,
      "env": ["DATABASE_URL", "CI"]
    },
    "db:apply": {
      "cache": false,
      "env": ["DATABASE_URL", "CI"]
    }
  }
}
