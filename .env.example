DATABASE_URL=postgres://interval:interval@localhost:5432/interval?sslmode=disable
# Better Auth (ADR-0004). Any 32+ character random string for local dev.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789
BETTER_AUTH_URL=http://localhost:3100
# Our proxies in front of the web app (P3-W13-S07's guest limit reads the visitor's
# address from X-Forwarded-For): 0 locally, 1 on the VM (Caddy), 2 on AWS.
TRUSTED_PROXIES=0
# Auth email (Q-P1-33): logged locally; allowed only while BETTER_AUTH_URL is localhost.
MAIL_TRANSPORT=log
# Events (DB-5): a JSON-lines file per day locally; Firehose when deployed. Relative to the repo root.
EVENTS_TRANSPORT=file
EVENTS_DIR=.data/events
# Tracing (OPS-2): unset exports nothing (log lines still carry trace ids); `console`
# prints spans. The beta's ADOT sidecar sets OTLP export instead.
# OTEL_TRACES_EXPORTER=console
# Queues (ADR-0014): BullMQ on the local Valkey (docker-compose.yml). AWS uses sqs.
QUEUE_TRANSPORT=bullmq
VALKEY_URL=redis://localhost:6379

# Model providers (ADR-0007), read only by commands that call a model through the
# gateway (draft-concepts now; tagging and embeddings later). Leave empty locally
# unless you mean to spend money.
OPENROUTER_API_KEY=
VOYAGE_API_KEY=
# Groq (ADR-0020): a second LLM provider, used for a model set as "groq:<model id>".
GROQ_API_KEY=
# Google's Gemini API (ADR-0021): a model set as "google:<model id>", e.g.
# TAGGING_MODEL=google:gemma-4-31b-it.
GOOGLE_API_KEY=
# Concept tagging (P1-W3-S02): the OpenRouter model id the tagging eval picked
# (`eval-tagging`, ADR-0010). Unset, the consumer runs with tagging off.
# A "groq:" prefix routes to Groq (ADR-0020); a bare id is OpenRouter.
# A decision model on OpenRouter's Decisions API is "decisions:<id>", e.g.
# TAGGING_MODEL=decisions:typesafe/jev-1.14 (output tokens free; input billed).
# TAGGING_MODEL=
# Moment embeddings (P1-W3-S04): the Voyage model the embeddings eval picked
# (`eval-embeddings`, Q-P1-27). Unset, the consumer runs with embeddings off.
# EMBEDDING_MODEL=
# Personal project lines (P2-W12-S05, ADR-0025): the OpenRouter model that writes each
# user's line on why a card matters to their repositories. Unset, no project lines are
# written. Card explanations themselves are templates and never use a model.
# NOTES_MODEL=
# Question drafting (Q-1, Q-P2-10, P2-W8-S01): the OpenRouter model that drafts each
# tagged moment's questions. Unset, no questions are drafted. A rate limit or an error
# retries every 5 minutes.
# QUESTIONS_MODEL=nvidia/nemotron-3.5-super-vl:free
# Or, at half price through OpenRouter's Batch API (Q-P2-13): `question-batches` (every
# 30 minutes on the VM and in AWS) collects and submits; nothing is drafted per moment.
# QUESTIONS_MODEL=batch:anthropic/claude-haiku-5.5

# Concept explainers (§5G, ADR-0038, P4-W22-S01): `write-explainers --limit N` asks this
# model for one spoken script per concept, from full-text sources, for the owner to
# approve on /admin/explainers. A model of the question-generation class, at most
# $0.80 per million output tokens, within the daily AI budget. Unset means off.
# EXPLAINER_MODEL=

# TTS (TTS-1, Q-P4-07, P4-W22-S03): each provider is on only with its key and voice;
# none is called before. Their calls count against the daily AI budget above (owner,
# 2026-11-09). `tts-blind-test` says the 5 scripts in workers/jobs/seeds/tts_scripts.yaml
# with every provider on, for the owner's pick on /admin/tts; at list prices the whole
# test costs more than 30 cents, so raise the cap for that run. Then TTS_PROVIDER names
# the voice explainers use (elevenlabs, inworld or polly).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE=
# INWORLD_API_KEY=          # the Base64 credentials from Inworld's portal, as given
# INWORLD_VOICE=
# POLLY_VOICE=              # with the worker's AWS credentials (as S3)
# TTS_PROVIDER=

# Topic paths (§5F, Q-P2-25, P2-W10-S01): `propose-paths` asks this model for candidate
# paths and their order, saved as drafts for review. Run by hand; unset means off.
# PATHS_MODEL=deepseek/deepseek-v4.1-flash

# Private files: PDF books (DB-6, ADR-0011, P2-W11-S01). Locally, SeaweedFS from
# docker-compose; it accepts any credentials. Create the bucket once: pnpm files:init
PRIVATE_CONTENT_BUCKET=interval-private
AWS_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:8333
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Public media (CACHE-4, P4-W22-S04): voiced explainers as HLS, served at /media/* by
# CloudFront (AWS) or Caddy (a VM's own SeaweedFS). Locally the same SeaweedFS; files:init
# creates this bucket too. MEDIA_S3_ENDPOINT is unset in AWS mode.
MEDIA_BUCKET=interval-media
MEDIA_S3_ENDPOINT=http://127.0.0.1:8333

# OCR for scanned book pages (ADR-0022, P2-W11-S03): the Tesseract container from
# docker-compose (docker compose up -d ocr).
OCR_URL=http://127.0.0.1:8884

# GitHub projects (ADR-0024, P2-W12-S01): Interval's GitHub App, registered by the owner
# (read-only Metadata and Contents; "Request user authorization during installation";
# callback http://localhost:3100/api/github/callback). Unset: connecting isn't offered.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The worker's reads (P2-W12-S02): the App's id and private key (PEM, or base64 of it).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# P3-W15-S02 (ADR-0033): match tickets, shared by the web app and the game server
# (services/game). At least 32 characters, e.g. `openssl rand -hex 32`. Empty: live
# games aren't offered.
GAME_TICKET_SECRET=

# P5-W31-S02b-2 (ADR-0041): Velox, which judges LLD battle code for the game server
# (POST /judge). The key's ID must be in Velox's JUDGE_API_KEY_IDS. Empty: the game
# server plays quiz matches and refuses battles.
VELOX_URL=
VELOX_API_KEY=

# P5-W32 (Q-P5-12): ranked battle windows run at 21:00 nightly and 11:00 at weekends in
# this IANA zone (the deployment's region). Empty: UTC.
BATTLE_WINDOW_TIME_ZONE=

# P3-W17-S05b (Q-P3-18): web push for the agent hook. Make a pair with `pnpm push:keys`;
# empty leaves push off. The subject is how push services reach you (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# P4-W19-S04b (Q-P4-03): native push straight to APNs and FCM. Empty means off.
# APNS_KEY: base64 of the .p8 key file; APNS_SANDBOX=1 for development builds.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_SANDBOX=
# FCM_SERVICE_ACCOUNT: base64 of the Firebase service account's JSON file.
FCM_SERVICE_ACCOUNT=
