DATABASE_URL=postgres://interval:interval@localhost:5432/interval?sslmode=disable
# Better Auth (ADR-0004). Any 32+ character random string for local dev.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789
BETTER_AUTH_URL=http://localhost:3100
# Auth email (Q-P1-33): logged locally; allowed only while BETTER_AUTH_URL is localhost.
MAIL_TRANSPORT=log
# Events (DB-5): a JSON-lines file per day locally; Firehose when deployed. Relative to the repo root.
EVENTS_TRANSPORT=file
EVENTS_DIR=.data/events
# Tracing (OPS-2): unset exports nothing (log lines still carry trace ids); `console`
# prints spans. The beta's ADOT sidecar sets OTLP export instead.
# OTEL_TRACES_EXPORTER=console
# Queues (ADR-0014): BullMQ on the local Valkey (docker-compose.yml). AWS uses sqs.
QUEUE_TRANSPORT=bullmq
VALKEY_URL=redis://localhost:6379
