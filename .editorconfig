root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.go]
indent_style = tab

[{Makefile,makefile,*.mk}]
indent_style = tab

# Trailing double spaces are hard line breaks in Markdown, and the docs copied
# from the blueprint depend on them.
[*.md]
trim_trailing_whitespace = false

# Byte-for-byte copies of the source documents. Never reformat.
[docs/_source/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
